PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/haajari
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:5180
# dev = OTP is shown on screen (no SMS needed). Set to sms when an SMS provider is added.
OTP_MODE=dev
# Phone notifications (Web Push). Leave empty to auto-create keys in server/.vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@your-school.in

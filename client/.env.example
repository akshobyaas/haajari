# Copy to client/.env to change these. All are optional.

# Dev server ports (npm run dev / npm run demo).
DEV_PORT=5180
PREVIEW_PORT=4173

# Where the dev server sends /api requests (the Express API).
API_PROXY_TARGET=http://localhost:5000

# Only if the API is on a different address from the app (normally leave empty: same origin).
# VITE_API_URL=https://api.example.org/api
